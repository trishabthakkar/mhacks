{
  "name": "sprout-mcp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test src/*.test.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/express": "5.0.6",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "express": "5.2.1",
    "spacetimedb": "2.10.2",
    "undici": "6.29.0",
    "zod": "4.6.5"
  }
}
